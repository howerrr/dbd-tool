[{"id":"addon:rites_of_judgement:iridescent_seal_of_metatron","kind":"addon","ownerId":"k-20","title":"荧虹梅塔特隆印章","titleEn":"Iridescent Seal of Metatron","rarity":"ultra","description":["刻有古怪图案的护身符。它似乎已经受到了恶灵的影响。","·诅咒惩戒的距离减少50%。","·生成审判仪式路径会增加诅咒惩戒的距离，至多为200%。","·诅咒惩戒命中逃生者时，此效果重置。"],"flavor":"‘这个具有强力保护和驱散效果的幻方被称为‘维伦第七纹章’或‘梅塔特隆的封印’。”","icon":"/icons/IconAddon_iridescentSealOfMetatron.webp","glyph":6,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Iridescent_Seal_of_Metatron","pinyin":"yinghongmeitatelongyinzhang","initials":"yhmttlyz"},{"id":"addon:rites_of_judgement:obsidian_goblet","kind":"addon","ownerId":"k-20","title":"黑曜石杯","titleEn":"Obsidian Goblet","rarity":"ultra","description":["用纯黑曜石雕刻而成的古老高脚杯。","·使用诅咒惩戒特殊破坏可破坏墙壁与木板。","·诅咒惩戒的冷却时间增加20%。"],"flavor":"“原谅我将你唤醒。但没有你的话，我真的无法坚持下去。”——詹姆士·桑德兰","icon":"/icons/IconAddon_obsidianGoblet.webp","glyph":2,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Obsidian_Goblet","pinyin":"heiyaoshibei","initials":"hysb"},{"id":"addon:rites_of_judgement:lost_memories_book","kind":"addon","ownerId":"k-20","title":"《失落的记忆》","titleEn":"Lost Memories Book","rarity":"very-rare","description":["一本关于寂静岭及周围地区历史与传说的书籍。","· 被诅咒惩戒伤害的逃生者会受到浑然不觉状态影响，持续80秒。","浑然不觉状态会使逃生者无法听到或受到杀手的恐惧范围影响。"],"flavor":"“他们把这个地方称作‘寂静魂灵之地’。”","icon":"/icons/IconAddon_lostMemoriesBook.webp","glyph":3,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Lost_Memories_Book","pinyin":"shiluodejiyi","initials":"sldjy"},{"id":"addon:rites_of_judgement:crimson_ceremony_book","kind":"addon","ownerId":"k-20","title":"《赤色祭祀》","titleEn":"Crimson Ceremony Book","rarity":"very-rare","description":["一本关于古神的书。作者未知。","·被诅咒惩戒伤害的逃生者会受到出血与重伤状态影响，持续80秒。","出血状态会使治疗进度在中断治疗后回退，并使受伤逃生者留下的血迹增加。该效果会持续一段时间，或直至被完全治疗。","重伤状态会使治疗所需时间增加25%，该效果会持续一段时间，或直至被完全治疗。"],"flavor":"“说吧。我是赤色之神。谎言与雾气不是他人，而是我。”","icon":"/icons/IconAddon_crimsonCeremonyBook.webp","glyph":7,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Crimson_Ceremony_Book","pinyin":"chisejisi","initials":"csjs"},{"id":"addon:rites_of_judgement:scarlet_egg","kind":"addon","ownerId":"k-20","title":"深红色蛋","titleEn":"Scarlet Egg","rarity":"very-rare","description":["新鲜的鸡蛋，表面是鲜艳的红色。大概有鹌鹑蛋那么大。","·受到折磨状态影响的逃生者冲刺时会生成审判仪式路径。这些路径会存在5秒。","·不再能看到审判仪式路径的气场。"],"flavor":"“我这辈子从来没有这么害怕过！你完全不关心我……对吗？”——玛丽亚","icon":"/icons/IconAddon_scarletEgg.webp","glyph":1,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Scarlet_Egg","pinyin":"shenhongsedan","initials":"shsd"},{"id":"addon:rites_of_judgement:rust_coloured_egg","kind":"addon","ownerId":"k-20","title":"红锈色蛋","titleEn":"Rust-Coloured Egg","rarity":"very-rare","description":["一个看起来很旧的蛋，表面涂上了红橙色。大概有鹌鹑蛋那么大。","·使用诅咒惩戒伤害逃生者会使审判仪式充能增加30%。"],"flavor":"“詹姆士......你让我很开心。”——玛丽","icon":"/icons/IconAddon_rustColoredEgg.webp","glyph":3,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Rust-Coloured_Egg","pinyin":"hongxiusedan","initials":"hxsd"},{"id":"addon:rites_of_judgement:misty_day_remains_of_judgement","kind":"addon","ownerId":"k-20","title":"《大雾之日，审判之迹》","titleEn":"Misty Day, Remains of Judgement","rarity":"rare","description":["一副描绘某个头戴钢制金字塔的庞大身影的画作。背景里还有被困在牢笼里的受害者。","· 使用诅咒惩戒伤害逃生者会使其气场显示8秒。"],"flavor":"“是他……”","icon":"/icons/IconAddon_mistyDay.webp","glyph":2,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Misty_Day,_Remains_of_Judgement","pinyin":"dawuzhirishenpanzhiji","initials":"dwzrspzj"},{"id":"addon:rites_of_judgement:mannequin_foot","kind":"addon","ownerId":"k-20","title":"假人脚掌","titleEn":"Mannequin Foot","rarity":"rare","description":["某个假人的光滑灰色脚掌，被从腿部粗暴地扯了下来。","·审判仪式路径会施加疲劳状态，持续10秒。"],"flavor":"","icon":"/icons/IconAddon_mannequinFoot.webp","glyph":6,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Mannequin_Foot","pinyin":"jiarenjiaozhang","initials":"jrjz"},{"id":"addon:rites_of_judgement:tablet_of_the_oppressor","kind":"addon","ownerId":"k-20","title":"压迫者平板","titleEn":"Tablet of the Oppressor","rarity":"rare","description":["刻有阿兹特克人像的金属板。","· 使用审判仪式期间，获得无法侦测状态。"],"flavor":"","icon":"/icons/IconAddon_tabletOfTheOppressor.webp","glyph":7,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Tablet_of_the_Oppressor","pinyin":"yapozhepingban","initials":"ypzpb"},{"id":"addon:rites_of_judgement:burning_man_painting","kind":"addon","ownerId":"k-20","title":"火人绘画","titleEn":"Burning Man Painting","rarity":"rare","description":["湖景酒店的示意图。这处罪恶之地上面画满了火红的烈焰。","·诅咒惩戒落空时，周围3米范围内的逃生者气场向你显示6秒。"],"flavor":"","icon":"/icons/IconAddon_burningManPainting.webp","glyph":4,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Burning_Man_Painting","pinyin":"huorenhuihua","initials":"hrhh"},{"id":"addon:rites_of_judgement:valtiel_sect_photograph","kind":"addon","ownerId":"k-20","title":"神使教派照片","titleEn":"Valtiel Sect Photograph","rarity":"rare","description":["一张有两个红兜帽身影的照片。其名为《众神的深红与白色晚宴》。","·每有一个受折磨状态影响的逃生者，你的恐惧范围减少2米。"],"flavor":"","icon":"/icons/IconAddon_valtielSectPhotograph.webp","glyph":7,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Valtiel_Sect_Photograph","pinyin":"shenshijiaopaizhaopian","initials":"ssjpzp"},{"id":"addon:rites_of_judgement:cinderella_music_box","kind":"addon","ownerId":"k-20","title":"灰姑娘音乐盒","titleEn":"Cinderella Music Box","rarity":"uncommon","description":["绘有童话中灰姑娘形象的音乐盒。它在某个手提箱内被找到，上面贴有多个目的地的贴纸。","· 诅咒惩戒冷却时间减少10%。"],"flavor":"","icon":"/icons/IconAddon_cinderellaMusicBox.webp","glyph":2,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Cinderella_Music_Box","pinyin":"huiguniangyinyuehe","initials":"hgnyyh"},{"id":"addon:rites_of_judgement:spearhead","kind":"addon","ownerId":"k-20","title":"矛头","titleEn":"Spearhead","rarity":"uncommon","description":["某根曾锋利的锈蚀矛尖。上面沾满了最后一位受害者的鲜血。","·逃生者被从赎罪牢笼中解救时，你会看到其救援者的气场，持续8秒。"],"flavor":"","icon":"/icons/IconAddon_spearhead.webp","glyph":6,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Spearhead","pinyin":"maotou","initials":"mt"},{"id":"addon:rites_of_judgement:wax_doll","kind":"addon","ownerId":"k-20","title":"蜡像人偶","titleEn":"Wax Doll","rarity":"uncommon","description":["一个用蜡刻成的玩偶，由某个即将面临审判的囚犯亲手制作而成。","·诅咒惩戒范围增加5%。"],"flavor":"","icon":"/icons/IconAddon_waxDoll.webp","glyph":3,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Wax_Doll","pinyin":"laxiangrenou","initials":"lxro"},{"id":"addon:rites_of_judgement:forgotten_videotape","kind":"addon","ownerId":"k-20","title":"被遗忘的录像带","titleEn":"Forgotten Videotape","rarity":"uncommon","description":["记录了一对情侣前往寂静岭旅游的录像带。尽管它承载了一段美好记忆，但还是被留在了湖景酒店。","· 诅咒惩戒移动速度增加10%。"],"flavor":"","icon":"/icons/IconAddon_forgottenVideotape.webp","glyph":7,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Forgotten_Videotape","pinyin":"beiyiwangdeluxiangdai","initials":"bywdlxd"},{"id":"addon:rites_of_judgement:leopard_print_fabric","kind":"addon","ownerId":"k-20","title":"豹纹面料","titleEn":"Leopard-Print Fabric","rarity":"uncommon","description":["一块粉色的豹纹面料碎片。很难说这东西是做什么用的。","· 使用审判仪式期间，被击晕的持续时间减少15%。"],"flavor":"“我是谁无所谓。我是来找你的，詹姆士。”——玛丽亚","icon":"/icons/IconAddon_leopardprintFabric.webp","glyph":4,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Leopard-Print_Fabric","pinyin":"baowenmianliao","initials":"bwml"},{"id":"addon:rites_of_judgement:dead_butterfly","kind":"addon","ownerId":"k-20","title":"死蝴蝶","titleEn":"Dead Butterfly","rarity":"common","description":["在林边公寓的某张床上发现的蝴蝶。它已脆如枯叶，仿佛轻轻一碰就会化为尘埃。","· 审判仪式的充能速度增加10%。"],"flavor":"","icon":"/icons/IconAddon_deadButterfly.webp","glyph":7,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Dead_Butterfly","pinyin":"sihudie","initials":"shd"},{"id":"addon:rites_of_judgement:lead_ring","kind":"addon","ownerId":"k-20","title":"铅戒指","titleEn":"Lead Ring","rarity":"common","description":["在一处冰箱里被发现。上面刻有一张令人作呕的肿胀脸庞。","·诅咒惩戒的距离增加25%。","·诅咒惩戒的宽度减少25%。"],"flavor":"","icon":"/icons/IconAddon_leadRing.webp","glyph":4,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Lead_Ring","pinyin":"qianjiezhi","initials":"qjz"},{"id":"addon:rites_of_judgement:copper_ring","kind":"addon","ownerId":"k-20","title":"铜戒指","titleEn":"Copper Ring","rarity":"common","description":["发现于布鲁克海文医院的地下室里。上面刻有一只蜘蛛。","·审判仪式最大持续时间增加5秒。"],"flavor":"“我被锁在医院的地下室里。那里又小又黑，我好害怕。我珍贵的戒指被落在了那里。但我绝对不会再回去了。”","icon":"/icons/IconAddon_copperRing.webp","glyph":1,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Copper_Ring","pinyin":"tongjiezhi","initials":"tjz"},{"id":"addon:rites_of_judgement:black_strap","kind":"addon","ownerId":"k-20","title":"黑色绑带","titleEn":"Black Strap","rarity":"common","description":["用于将受害者捆在金属框架上的尼龙绑带。绑带本身的颜色使人很难分辨出渗入其中的鲜血。","·诅咒惩戒的距离减少25%。","·诅咒惩戒的宽度增加25%。"],"flavor":"","icon":"/icons/IconAddon_blackStrap.webp","glyph":1,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Black_Strap","pinyin":"heisebangdai","initials":"hsbd"}]
