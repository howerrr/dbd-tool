[{"id":"addon:test_subject_001:iridescent_soteria_chip","kind":"addon","ownerId":"k-42","title":"荧虹索缇莉亚芯片","titleEn":null,"rarity":"ultra","description":["曾经用来限制力量的芯片，如今却成了他更强力量的源泉。","当破界者激活时，杀手获得无法侦测状态，拥有一层以上破界者印记的逃生者进入杀手附近12米范围内时会显示气场。","此效果将持续至杀手发起藤蔓攻击、进入颠倒世界或破界者结束。","无法侦测状态会隐藏杀手的气场、恐惧范围与红光。"],"flavor":"","icon":"/icons/IconAddon_IridescentSoteriaChip.webp","glyph":4,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Iridescent_Soteria_Chip","pinyin":"yinghongsuotiliyaxinpian","initials":"yhstlyxp"},{"id":"addon:test_subject_001:chess_piece","kind":"addon","ownerId":"k-42","title":"象棋棋子","titleEn":null,"rarity":"ultra","description":["这是实验室里为数不多的娱乐方式之一，帮助孩子们学习逻辑和策略。","可以连续进行两次藤蔓攻击，攻击半径缩小40%。"],"flavor":"","icon":"/icons/IconAddon_ChessPiece.webp","glyph":0,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Chess_Piece","pinyin":"xiangqiqizi","initials":"xqqz"},{"id":"addon:test_subject_001:rabbit_remains","kind":"addon","ownerId":"k-42","title":"兔子尸体","titleEn":null,"rarity":"very-rare","description":["在屠杀全家之前，亨利先猎杀的是兔子，并将它们的尸体分散在镇上各处。","处于或正在进入地下门攻击范围内的逃生者会受到疲劳状态影响，并在离开范围后持续10秒。","穿越颠倒世界冷却时间延长5秒。","疲劳状态会使逃生者无法激活疲劳相关技能。"],"flavor":"","icon":"/icons/IconAddon_RabbitRemains.webp","glyph":1,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Rabbit_Remains","pinyin":"tuzishiti","initials":"tzst"},{"id":"addon:test_subject_001:electroshock_collar","kind":"addon","ownerId":"k-42","title":"电击项圈","titleEn":null,"rarity":"very-rare","description":["一种残酷又高效的训练和惩罚实验室囚徒的方式。","离开颠倒世界时，32米范围内的所有窗户会被封锁12秒。"],"flavor":"","icon":"/icons/IconAddon_ElectroshockCollar.webp","glyph":7,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Electroshock_Collar","pinyin":"dianjixiangquan","initials":"djxq"},{"id":"addon:test_subject_001:broken_skateboard","kind":"addon","ownerId":"k-42","title":"破损的滑板","titleEn":null,"rarity":"very-rare","description":["炫酷的出行方式，却被哥哥暴力砸坏，以彰显他的控制力。","当破界者模式开始时，在接下来65秒内，普通翻越窗户的速度加快30%，32米范围内木板和窗户的气场对你显示。"],"flavor":"","icon":"/icons/IconAddon_BrokenSkateboard.webp","glyph":1,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Broken_Skateboard","pinyin":"posundehuaban","initials":"psdhb"},{"id":"addon:test_subject_001:black_widow_spider","kind":"addon","ownerId":"k-42","title":"黑寡妇蜘蛛","titleEn":null,"rarity":"very-rare","description":["一只恐怖的蜘蛛，不再只是幻觉。","在破界者模式下进入颠倒世界会让36米以外最远的逃生者暴露位置，持续3秒。"],"flavor":"一只恐怖的蜘蛛，不再只是幻觉。","icon":"/icons/IconAddon_BlackWidowSpider.webp","glyph":1,"confidence":0.97,"source":"https://deadbydaylight.wiki.gg/wiki/Black_Widow_Spider","pinyin":"heiguafuzhizhu","initials":"hgfzz"},{"id":"addon:test_subject_001:forged_death_certificate","kind":"addon","ownerId":"k-42","title":"伪造的死亡证明","titleEn":null,"rarity":"rare","description":["某位拥有超能力的人用来假死的证明文件。","每次通过藤蔓攻击让逃生者增加1层破界者印记，你会获得无法侦测状态，直到下一次破界者模式激活。","无法侦测状态会隐藏杀手的气场、恐惧范围与红光。"],"flavor":"","icon":"/icons/IconAddon_ForgedDeathCertificate.webp","glyph":7,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Forged_Death_Certificate","pinyin":"weizaodesiwangzhengming","initials":"wzdswzm"},{"id":"addon:test_subject_001:pizza_goggles","kind":"addon","ownerId":"k-42","title":"披萨盒眼镜","titleEn":null,"rarity":"rare","description":["在十一进入感官剥夺舱时使用，它们可以消除干扰，让她集中注意力。","地下门攻击有效范围缩小90%，冷却时间缩短25秒。","激活地下门攻击后的硬直时间缩短80%。"],"flavor":"","icon":"/icons/IconAddon_PizzaGoggles.webp","glyph":4,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Pizza_Goggles","pinyin":"pisaheyanjing","initials":"pshyj"},{"id":"addon:test_subject_001:electrode_cap","kind":"addon","ownerId":"k-42","title":"电极帽","titleEn":null,"rarity":"rare","description":["用于检测大脑的电波活动。在实验室里，任何蛛丝马迹都不会被忽略。","破界者模式第二阶段开始时（或是当逃生者完成与祖父时钟的交互时），距离杀手26米以上的逃生者气场将显示6秒。"],"flavor":"","icon":"/icons/IconAddon_ElectrodeCap.webp","glyph":1,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Electrode_Cap","pinyin":"dianjimao","initials":"djm"},{"id":"addon:test_subject_001:victor_s_razor_blade","kind":"addon","ownerId":"k-42","title":"维克多的剃须刀","titleEn":null,"rarity":"rare","description":["亨利的父亲悲痛欲绝，用藏在袖子里的刀片挖出了自己的双眼。","当破界者模式结束时，受伤的逃生者会在接下来的20秒内受到不治状态效果影响。","不治状态会使逃生者无法被治疗。"],"flavor":"亨利的父亲悲痛欲绝，用藏在袖子里的刀片挖出了自己的双眼。","icon":"/icons/IconAddon_VictorsRazorBlade.webp","glyph":2,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Victor%27s_Razor_Blade","pinyin":"weikeduodetixudao","initials":"wkddtxd"},{"id":"addon:test_subject_001:neck_tendril","kind":"addon","ownerId":"k-42","title":"颈须","titleEn":null,"rarity":"rare","description":["当麦克斯逃离意识幻境、扯断了他颈部的触须时，他怒不可遏。","在破界者模式下被藤蔓攻击命中的逃生者会受到出血和重伤状态影响，持续70秒。","出血状态会使治疗进度在中断治疗后回退，并使受伤逃生者留下的血迹增加。该效果会持续一段时间，或直至被完全治疗。","重伤状态会使治疗所需时间增加25%，该效果会持续一段时间，或直至被完全治疗。"],"flavor":"当麦克斯逃离意识幻境、扯断了他颈部的触须时，他怒不可遏。","icon":"/icons/IconAddon_NeckTendril.webp","glyph":5,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Neck_Tendril","pinyin":"jingxu","initials":"jx"},{"id":"addon:test_subject_001:gutted_supercom","kind":"addon","ownerId":"k-42","title":"报废对讲机","titleEn":null,"rarity":"uncommon","description":["一台损坏的通讯设备，现在却会在最恐怖的时刻突然启动。","非破界者模式下，被藤蔓攻击命中的逃生者会显示气场，持续1.5秒。"],"flavor":"","icon":"/icons/IconAddon_GuttedSupercom.webp","glyph":7,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Gutted_Supercom","pinyin":"baofeiduijiangji","initials":"bfdjj"},{"id":"addon:test_subject_001:clock_hands","kind":"addon","ownerId":"k-42","title":"时钟指针","titleEn":null,"rarity":"uncommon","description":["克里尔家祖父时钟的指针，被亨利的黑暗力量侵蚀。","逃生者与祖父时钟交互时，会受到浑然不觉状态影响，并在互动结束后持续12秒。","浑然不觉状态会使逃生者无法听到或受到杀手的恐惧范围影响。"],"flavor":"","icon":"/icons/IconAddon_ClockHands.webp","glyph":4,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Clock_Hands","pinyin":"shizhongzhizhen","initials":"szzz"},{"id":"addon:test_subject_001:bloody_roller_skate","kind":"addon","ownerId":"k-42","title":"染血轮滑鞋","titleEn":null,"rarity":"uncommon","description":["十一宣泄愤怒情绪的纪念品。","激活地下门攻击后，杀手在离开时获得2秒20%急速状态。","急速状态增加杀手移速。"],"flavor":"","icon":"/icons/IconAddon_BloodyRollerSkate.webp","glyph":6,"confidence":0.9,"source":"https://deadbydaylight.wiki.gg/wiki/Bloody_Roller_Skate","pinyin":"ranxuelunhuaxie","initials":"rxlhx"},{"id":"addon:test_subject_001:shattered_wrist_rocket","kind":"addon","ownerId":"k-42","title":"残破弹弓","titleEn":null,"rarity":"uncommon","description":["曾经威力强大的弹弓，如今已残破不堪。","地下门攻击时，扔下的木板和范围内的发电机会被特殊破坏并爆炸。"],"flavor":"","icon":"/icons/IconAddon_ShatteredWristRocket.webp","glyph":6,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Shattered_Wrist_Rocket","pinyin":"canpodangong","initials":"cpdg"},{"id":"addon:test_subject_001:smashed_cassette_deck","kind":"addon","ownerId":"k-42","title":"破损磁带","titleEn":null,"rarity":"uncommon","description":["他们曾用音乐逃脱亨利的魔爪。如今失去了音乐，他们毫无胜算。","对局开始时，所有逃生者发出尖叫声。","所有逃生者开局时拥有1层破界者印记。破界者首次激活时，所有逃生者将失去所有破界者印记。","地图上将少出现1座祖父时钟。"],"flavor":"","icon":"/icons/IconAddon_SmashedCassetteDeck.webp","glyph":1,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Smashed_Cassette_Deck","pinyin":"posuncidai","initials":"pscd"},{"id":"addon:test_subject_001:mid_century_radio","kind":"addon","ownerId":"k-42","title":"中世纪广播","titleEn":null,"rarity":"common","description":["它在克里尔家的餐厅里静待屠杀的开始。","破界者模式下，显示32米之外、逃生者与之交互的祖父时钟的气场。"],"flavor":"","icon":"/icons/IconAddon_Mid-CenturyRadio.webp","glyph":2,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Mid-Century_Radio","pinyin":"zhongshijiguangbo","initials":"zsjgb"},{"id":"addon:test_subject_001:stained_glass_mural","kind":"addon","ownerId":"k-42","title":"彩色玻璃窗","titleEn":null,"rarity":"common","description":["曾经出现在克里尔家大门上的图案。如今，它笼罩着通往另一维度的大门。","颠倒世界冷却期间，普通破坏木板和墙壁可缩短冷却时间12秒。"],"flavor":"","icon":"/icons/IconAddon_StainedGlassMural.webp","glyph":0,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Stained_Glass_Mural","pinyin":"caisebolichuang","initials":"csblc"},{"id":"addon:test_subject_001:orderly_id","kind":"addon","ownerId":"k-42","title":"管理员ID","titleEn":null,"rarity":"common","description":["上面还是亨利·克里尔被另一维度改变前的样貌。","在非破界者模式下，藤蔓攻击的瞄准范围扩大2米。"],"flavor":"","icon":"/icons/IconAddon_OrderlyID.webp","glyph":6,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Orderly_ID","pinyin":"guanliyuanid","initials":"glyid"},{"id":"addon:test_subject_001:bead_maze","kind":"addon","ownerId":"k-42","title":"绕珠玩具","titleEn":null,"rarity":"common","description":["一种益智玩具，用于丰富被囚禁儿童的智力。","每有一名存活的逃生者，破界者第二阶段的倒计时就延长2.5秒。"],"flavor":"","icon":"/icons/IconAddon_BeadMaze.webp","glyph":7,"confidence":0.99,"source":"https://deadbydaylight.wiki.gg/wiki/Bead_Maze","pinyin":"raozhuwanju","initials":"rzwj"}]
