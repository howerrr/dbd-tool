[{"id":"addon:bag_of_toys:allie_s_scalp","kind":"addon","ownerId":"k-45","title":"艾莉的头皮","titleEn":"Allie's Scalp","rarity":"common","description":["每场对局一次，用普通攻击击倒处于折磨效果的逃生者时，对其施加恐惧状态。"],"flavor":"“最恐怖的时刻，往往始于一个简单的伤口。”","icon":"/icons/T_UI_iconAddon_AlliesScalp.webp","glyph":1,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Allie's_Scalp","pinyin":"ailidetoupi","initials":"aldtp"},{"id":"addon:bag_of_toys:blackened_heart","kind":"addon","ownerId":"k-45","title":"发黑的心脏","titleEn":"Blackened Heart","rarity":"common","description":["嘲讽逃生者后，用玩具击倒逃生者时，该玩具额外获得1点致命性。"],"flavor":"“一颗仍在跳动的心脏，乌黑，爬满了蛆虫。”","icon":"/icons/T_UI_iconAddon_BlackenedHeart.webp","glyph":0,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Blackened_Heart","pinyin":"faheidexinzang","initials":"fhdxz"},{"id":"addon:bag_of_toys:bottle_of_bleach","kind":"addon","ownerId":"k-45","title":"漂白剂瓶","titleEn":"Bottle of Bleach","rarity":"common","description":["折磨效果的衰减速度降低15%。"],"flavor":"“涂在伤口上会带来剧烈的疼痛。还能杀灭99.9%的家用细菌！”","icon":"/icons/T_UI_iconAddon_BottleOfBleach.webp","glyph":0,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Bottle_of_Bleach","pinyin":"piaobaijiping","initials":"pbjp"},{"id":"addon:bag_of_toys:mike_s_phone","kind":"addon","ownerId":"k-45","title":"迈克的手机","titleEn":"Mike's Phone","rarity":"common","description":["用玩具命中未处于回退状态的发电机时，该发电机损失5%进度并开始回退。"],"flavor":"“它坏了，就像迈克的脑袋一样。”","icon":"/icons/T_UI_iconAddon_MikesPhone.webp","glyph":7,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Mike's_Phone","pinyin":"maikedeshouji","initials":"mkdsj"},{"id":"addon:bag_of_toys:bloodstained_bullet","kind":"addon","ownerId":"k-45","title":"染血弹头","titleEn":"Bloodstained Bullet","rarity":"uncommon","description":["射击16米以外的逃生者时，获得10%急速状态，持续10秒。","当你施加折磨效果时，下一次开启百宝袋必定出现手枪。"],"flavor":"“一颗卡在塔拉尸体里的带血子弹。”","icon":"/icons/T_UI_iconAddon_BloodstainedBullet.webp","glyph":7,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Bloodstained_Bullet","pinyin":"ranxuetantou","initials":"rxtt"},{"id":"addon:bag_of_toys:brooke_s_pustule","kind":"addon","ownerId":"k-45","title":"布鲁克的脓疱","titleEn":"Brooke's Pustule","rarity":"uncommon","description":["站在酸液池中期间，以及离开酸液池后的5秒内，破坏木板和可破坏墙壁的速度提高25%。","当你施加折磨效果时，下一次开启百宝袋必定出现酸液瓶。"],"flavor":"“一个不断渗液的水泡，酸液腐蚀布鲁克脸部时还在冒泡。”","icon":"/icons/T_UI_iconAddon_BrooksPustule.webp","glyph":5,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Brooke's_Pustule","pinyin":"bulukedenongpao","initials":"blkdnp"},{"id":"addon:bag_of_toys:burnt_wings","kind":"addon","ownerId":"k-45","title":"烧焦的翅膀","titleEn":"Burnt Wings","rarity":"uncommon","description":["火焰的持续时间延长5秒。","当你施加折磨效果时，下一次开启百宝袋必定出现喷火器。"],"flavor":"“西耶娜珍视的一切都在烈火中化为灰烬。”","icon":"/icons/T_UI_iconAddon_BurntWings.webp","glyph":0,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Burnt_Wings","pinyin":"shaojiaodechibang","initials":"sjdcb"},{"id":"addon:bag_of_toys:shiny_tricycle","kind":"addon","ownerId":"k-45","title":"闪亮的三轮车","titleEn":"Shiny Tricycle","rarity":"uncommon","description":["当自行车喇叭侦测到超过1名逃生者时，揭露其他未被侦测到的逃生者的位置，持续8秒。","当你施加折磨效果时，下一次开启百宝袋必定出现自行车喇叭。"],"flavor":"“三个轮子意味着，即使在血流成河的地面上你也能保持平衡。”","icon":"/icons/T_UI_iconAddon_ShinyTricycle.webp","glyph":7,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Shiny_Tricycle","pinyin":"shanliangdesanlunche","initials":"sldslc"},{"id":"addon:bag_of_toys:sienna_s_flesh","kind":"addon","ownerId":"k-45","title":"西耶娜的血肉","titleEn":"Sienna's Flesh","rarity":"uncommon","description":["链枷的攻击范围扩大20%。","当你施加折磨效果时，下一次开启百宝袋必定出现链枷。"],"flavor":"“一块在残酷殴打中从西耶娜身上撕下的皮肉。”","icon":"/icons/T_UI_iconAddon_SiennasFlesh.webp","glyph":1,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Sienna's_Flesh","pinyin":"xiyenadexuerou","initials":"xyndxr"},{"id":"addon:bag_of_toys:candy_head_bowl","kind":"addon","ownerId":"k-45","title":"糖果头骨碗","titleEn":"Candy Head Bowl","rarity":"rare","description":["用自行车喇叭侦测到逃生者时，重置百宝袋的冷却时间。"],"flavor":"“把手伸进妈妈的头骨里，抓点糖吃。”","icon":"/icons/T_UI_iconAddon_CandyHeadBowl.webp","glyph":7,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Candy_Head_Bowl","pinyin":"tangguotouguwan","initials":"tgtgw"},{"id":"addon:bag_of_toys:dead_opossum","kind":"addon","ownerId":"k-45","title":"死负鼠","titleEn":"Dead Opossum","rarity":"rare","description":["用手枪或链枷命中逃生者时，揭露24米范围内所有其他逃生者的位置，持续3秒。"],"flavor":"“一具了无生气的尸体，却依然颇具娱乐价值。”","icon":"/icons/T_UI_iconAddon_DeadOpossum.webp","glyph":7,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Dead_Opossum","pinyin":"sifushu","initials":"sfs"},{"id":"addon:bag_of_toys:emily","kind":"addon","ownerId":"k-45","title":"艾米莉","titleEn":"Emily","rarity":"rare","description":["百宝袋中可用的玩具将以固定顺序出现：","·自行车喇叭。","·手枪。","·喷火器。","·链枷。","·酸液瓶。"],"flavor":"“一个瓷娃娃，它一定在想妈妈去哪儿了。”","icon":"/icons/T_UI_iconAddon_Emily.webp","glyph":0,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Emily","pinyin":"aimili","initials":"aml"},{"id":"addon:bag_of_toys:thornton_salt","kind":"addon","ownerId":"k-45","title":"桑顿的盐","titleEn":"Thornton Salt","rarity":"rare","description":["处于折磨效果的逃生者会受到重伤和出血状态影响。折磨效果结束后，这些状态仍将持续40秒。"],"flavor":"“有点消化过头了，不过除此之外还能用。”","icon":"/icons/T_UI_iconAddon_ThorntonSalt.webp","glyph":5,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Thornton_Salt","pinyin":"sangdundeyan","initials":"sddy"},{"id":"addon:bag_of_toys:victoria_s_eye","kind":"addon","ownerId":"k-45","title":"维多利亚的眼睛","titleEn":"Victoria's Eye","rarity":"rare","description":["用酸液瓶或喷火器命中逃生者时，揭露其气场，持续5秒。"],"flavor":"“有点消化过头了，不过除此之外还能用。”","icon":"/icons/T_UI_iconAddon_VictoriasEye.webp","glyph":3,"confidence":1,"source":"https://deadbydaylight.wiki.gg/wiki/Victoria's_Eye","pinyin":"weiduoliyadeyanjing","initials":"wdlydyj"},{"id":"addon:bag_of_toys:art_crispies","kind":"addon","ownerId":"k-45","title":"阿特脆片","titleEn":"Art Crispies","rarity":"very-rare","description":["当你施加折磨效果时，你与该逃生者都获得5%~15%的急速状态，持续5秒。"],"flavor":"“每盒都有惊喜！”","icon":"/icons/T_UI_iconAddon_ArtCrispies.webp","glyph":2,"confidence":1,"sourc